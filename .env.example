# --- LiteLLM gateway ----------------------------------------------------------
# URL of the LiteLLM gateway (OpenAI-compatible proxy) provided for the session.
LITELLM_BASE_URL=https://litellm.blent.ai/v1
# Virtual key issued by the gateway (usually starts with "sk-").
LITELLM_API_KEY=sk-...
# Language model: tool calls and structured outputs.
LITELLM_MODEL=gpt-5.4
# Vision model used to analyse photos (optional: defaults to LITELLM_MODEL).
LITELLM_VISION_MODEL=gpt-5.4
